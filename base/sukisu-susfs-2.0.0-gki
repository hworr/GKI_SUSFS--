name: SukiSU Kernel Build (GKI Fixed)

permissions:
  contents: write
  actions: write

on:
  workflow_dispatch:
    inputs:
      android_version:
        required: true
        type: string
      kernel_version:
        required: true
        type: string
      os_patch_level:
        required: true
        type: string
      kernelsu_variant:
        required: true
        type: string
      kernelsu_branch:
        required: true
        type: string
      kernelsu_branch_other:
        required: false
        type: string

jobs:
  build:
    runs-on: ubuntu-latest

    env:
      CCACHE_DIR: /home/runner/.ccache
      CCACHE_COMPILERCHECK: "%compiler% -dumpmachine; %compiler% -dumpversion"
      CCACHE_NOHASHDIR: "true"
      CCACHE_HARDLINK: "true"
      CCACHE_CPP2: "yes"

    steps:
    # --------------------------------------------------
    # SPACE + TOOLS
    # --------------------------------------------------
    - name: Maximize build space
      uses: easimon/maximize-build-space@master

    - name: Install dependencies
      run: |
        sudo apt update
        sudo apt install -y git curl python3 ccache

    # --------------------------------------------------
    # CCACHE
    # --------------------------------------------------
    - name: Restore ccache
      uses: actions/cache@v4
      with:
        path: /home/runner/.ccache
        key: ccache-${{ inputs.android_version }}-${{ inputs.kernel_version }}-${{ inputs.os_patch_level }}
        restore-keys: |
          ccache-${{ inputs.android_version }}-${{ inputs.kernel_version }}-
          ccache-${{ inputs.android_version }}-
          ccache-

    - name: Setup ccache
      run: |
        ccache --max-size=10G
        ccache --set-config=compression=true
        ccache --zero-stats

    # --------------------------------------------------
    # REPO + KERNEL
    # --------------------------------------------------
    - name: Install repo tool
      run: |
        mkdir -p git-repo
        curl https://storage.googleapis.com/git-repo-downloads/repo > git-repo/repo
        chmod +x git-repo/repo
        echo "REPO=$GITHUB_WORKSPACE/git-repo/repo" >> $GITHUB_ENV

    - name: Repo init & sync (GKI)
      run: |
        set -e
        BRANCH="android15-6.6-${{ inputs.os_patch_level }}"
        $REPO init -u https://android.googlesource.com/kernel/manifest -b common-$BRANCH
        $REPO sync -j$(nproc --all) --fail-fast

    # --------------------------------------------------
    # DEPENDENCIES
    # --------------------------------------------------
    - name: Clone SUSFS + AnyKernel3
      run: |
        git clone https://github.com/ShirkNeko/susfs4ksu.git -b gki-${{ inputs.android_version }}-${{ inputs.kernel_version }}
        git clone https://github.com/MiRinChan/AnyKernel3.git

    # --------------------------------------------------
    # KERNELSU BRANCH
    # --------------------------------------------------
    - name: Determine KernelSU branch
      run: |
        if [[ "${{ inputs.kernelsu_variant }}" == "SukiSU" ]]; then
          if [[ "${{ inputs.kernelsu_branch }}" == "Other" ]]; then
            echo "BRANCH=${{ inputs.kernelsu_branch_other }}" >> $GITHUB_ENV
          else
            echo "BRANCH=builtin" >> $GITHUB_ENV
          fi
        fi

    # --------------------------------------------------
    # BASEBAND GUARD (PATCH ONLY)
    # --------------------------------------------------
    - name: Apply Baseband Guard
      run: |
        set -e
        curl -LSs https://github.com/vc-teahouse/Baseband-guard/raw/main/setup.sh | bash
        sed -i '/^config LSM$/,/^help$/{/default/ s/lockdown/lockdown,baseband_guard/}' common/security/Kconfig

    # --------------------------------------------------
    # KERNELSU (SUKISU)
    # --------------------------------------------------
    - name: Add SukiSU
      if: ${{ inputs.kernelsu_variant == 'SukiSU' }}
      run: |
        curl -LSs https://raw.githubusercontent.com/SukiSU-Ultra/SukiSU-Ultra/main/kernel/setup.sh | bash -s "$BRANCH"

    # --------------------------------------------------
    # SUSFS (PATCH ONLY – NO DEFCONFIG)
    # --------------------------------------------------
    - name: Apply SUSFS core patch
      working-directory: common
      run: |
        set -e
        PATCH="$GITHUB_WORKSPACE/susfs4ksu/kernel_patches/50_add_susfs_in_gki-android15-6.6.patch"
        patch -p1 < "$PATCH" || true
        rm -f fs/proc/*.rej || true

    - name: Copy SUSFS files
      run: |
        cp susfs4ksu/kernel_patches/fs/* common/fs/
        cp susfs4ksu/kernel_patches/include/linux/* common/include/linux/

    # --------------------------------------------------
    # GKI DEFCONFIG SANITIZER (ABSOLUT KRITISCH)
    # --------------------------------------------------
    - name: Sanitize gki_defconfig (GKI safe)
      run: |
        set -e
        DEFCONFIG=common/arch/arm64/configs/gki_defconfig

        # ❌ GKI-verbotene Optionen entfernen
        sed -i '/^CONFIG_SUSFS/d' "$DEFCONFIG"
        sed -i '/^CONFIG_KSU_SUSFS/d' "$DEFCONFIG"
        sed -i '/^CONFIG_KSU_SUSFS_ENABLE_LOG/d' "$DEFCONFIG"
        sed -i '/^CONFIG_KSU_SUSFS_SPOOF_UNAME/d' "$DEFCONFIG"
        sed -i '/^CONFIG_BBG/d' "$DEFCONFIG"

        # ❌ auch KernelSU nicht fest verdrahten
        sed -i '/^CONFIG_KSU/d' "$DEFCONFIG"

    # --------------------------------------------------
    # BUILD
    # --------------------------------------------------
    - name: Build with retry
      uses: nick-fields/retry@v3
      with:
        timeout_minutes: 30
        max_attempts: 3
        retry_on: timeout
        command: |
          set -e
          cd "$GITHUB_WORKSPACE"

          sed -i 's/BUILD_SYSTEM_DLKM=1/BUILD_SYSTEM_DLKM=0/' common/build.config.gki.aarch64 || true
          sed -i '/MODULES_ORDER=android\/gki_aarch64_modules/d' common/build.config.gki.aarch64 || true
          sed -i '/KMI_SYMBOL_LIST_STRICT_MODE/d' common/build.config.gki.aarch64 || true

          if [ -f "build/build.sh" ]; then
            LTO=thin BUILD_CONFIG=common/build.config.gki.aarch64 \
              build/build.sh CC="/usr/bin/ccache clang"
          else
            tools/bazel build --config=fast //common:kernel_aarch64_dist
          fi

    # --------------------------------------------------
    # CCACHE STATS
    # --------------------------------------------------
    - name: Show ccache stats
      run: ccache --show-stats

    # --------------------------------------------------
    # PACKAGE
    # --------------------------------------------------
    - name: Package AnyKernel3
      run: |
        cp bazel-bin/common/kernel_aarch64/Image AnyKernel3/Image
        cd AnyKernel3
        zip -r ../kernel.zip .

    - name: Upload artifact
      uses: actions/upload-artifact@v4
      with:
        name: kernel
        path: kernel.zip
